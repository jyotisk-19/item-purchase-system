{
  "info": {
    "name": "Item & Purchase Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the SQL file and start the server (npm start) first. Requests in each folder are ordered so they can be run top to bottom."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Item Types",
      "item": [
        {
          "name": "Get all item types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/item-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "item-types"
              ]
            }
          }
        },
        {
          "name": "Create item type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/item-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "item-types"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type_name\": \"Toys\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update item type",
